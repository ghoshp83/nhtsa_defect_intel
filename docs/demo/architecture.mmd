%% NHTSA Defect Intelligence Agent — architecture
%% Two-panel view: (A) offline data pipeline, left-to-right.
%%                 (B) runtime query flow, top-down with the 4 tools as the visual centre.
%% Render at https://mermaid.live (paste each block separately if needed) or in draw.io.

%% =========================================================
%% Panel A — Offline data pipeline (runs on schedule)
%% =========================================================
flowchart LR
    classDef src   fill:#e3f2fd,stroke:#1565c0,color:#000;
    classDef med   fill:#fff8e1,stroke:#f9a825,color:#000;
    classDef tool  fill:#fce4ec,stroke:#c2185b,color:#000,font-weight:bold;

    SRC["<b>NHTSA open data</b><br/>recalls · complaints · investigations<br/>SGO AV crashes · TSBs"]:::src
    BR["<b>Bronze</b><br/>raw append-only<br/>PDFs in UC Volume"]:::med
    SI["<b>Silver</b><br/>typed · deduped · PII-scrubbed<br/><i>ai_parse_document on PDFs</i>"]:::med
    GO["<b>Gold</b><br/>star schema + narrative chunks<br/>3 fact · 4 dim · 1 chunk table"]:::med

    T1["🛠 <b>genie_recalls</b><br/>Genie space over gold facts"]:::tool
    T2["🛠 <b>vector_search_narrative</b><br/>VS index · gold_narrative_chunks"]:::tool
    T3["🛠 <b>fetch_tsb</b><br/>UC function"]:::tool
    T4["🛠 <b>fetch_investigation</b><br/>UC function"]:::tool

    SRC --> BR --> SI --> GO
    GO --> T1
    GO --> T2
    SI --> T3
    SI --> T4

%% =========================================================
%% Panel B — Runtime query flow (every chat turn)
%% =========================================================
flowchart TB
    classDef user  fill:#e8f5e9,stroke:#2e7d32,color:#000;
    classDef svc   fill:#ede7f6,stroke:#4527a0,color:#000;
    classDef tool  fill:#fce4ec,stroke:#c2185b,color:#000,font-weight:bold;
    classDef mem   fill:#fff3e0,stroke:#e65100,color:#000;
    classDef obs   fill:#e0f2f1,stroke:#00695c,color:#000;

    U["👤 <b>Analyst / regulator</b>"]:::user
    RA["<b>Review App</b><br/>chat UI"]:::svc
    EP["<b>Mosaic AI Endpoint</b><br/>nhtsa-agent-endpoint-dev-pg · v5"]:::svc
    AG["<b>NhtsaResponsesAgent</b><br/>Llama-4-Maverick · temp 0.2 · top-8"]:::svc

    subgraph TOOLS["Tools (parallel calls allowed)"]
        direction LR
        T1R["🛠 genie_recalls"]:::tool
        T2R["🛠 vector_search_narrative"]:::tool
        T3R["🛠 fetch_tsb"]:::tool
        T4R["🛠 fetch_investigation"]:::tool
    end

    MEM["🗂 <b>Lakebase Postgres</b><br/>agent_sessions + agent_turns<br/>accumulated_filters JSONB"]:::mem

    TR["<b>MLflow traces</b><br/>trace_logs_&lt;exp_id&gt;"]:::obs
    EV["<b>Hourly evaluate job</b><br/>3 cheap + 3 Guidelines scorers"]:::obs
    DB["📊 <b>Monitoring Dashboard</b><br/>latency · tool mix · judge pass rate"]:::obs

    U -->|question| RA --> EP --> AG
    AG -->|dispatch| TOOLS
    TOOLS -->|results| AG
    AG <-->|read prior · write turn| MEM
    AG -->|cited answer| EP --> RA --> U

    EP -. "auto-trace per turn" .-> TR
    TR --> EV --> DB
